{
  "name": "antigravity-hud",
  "version": "0.5.3",
  "description": "A beautiful, cross-platform statusline HUD for the Antigravity CLI: subagent runtimes, rate limit reset timers, context windows, OSC 8 links, tool tallies, and vibes.",
  "main": "bin/antigravity-hud.js",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "antigravity-hud": "bin/antigravity-hud.js"
  },
  "scripts": {
    "test": "node tests/test-hyperlinks.js && node tests/test-parser.js && node tests/test-render.js && node tests/test-integration.js"
  },
  "keywords": [
    "antigravity",
    "antigravity-cli",
    "agy",
    "gemini",
    "claude",
    "statusline",
    "hud",
    "cli",
    "devtools"
  ],
  "author": "KK",
  "license": "MIT",
  "homepage": "https://github.com/phenom64/antigravity-hud#readme",
  "bugs": {
    "url": "https://github.com/phenom64/antigravity-hud/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phenom64/antigravity-hud.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    "src/",
    "tests/",
    "legacy/",
    "scripts/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
